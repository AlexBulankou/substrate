+package controllers
+
+import (
+	"context"
+	"sync"
+
+	"github.com/agent-substrate/substrate/pkg/proto/ateapipb"
+	"google.golang.org/grpc"
+)
+
+type fakeControlCall struct {
+	method  string // "CreateActor" | "ResumeActor" | "SuspendActor" | "DeleteActor"
+	actorID string
+}
+
+// fakeControlClient implements ateapipb.ControlClient for envtest. The methods
+// the ActorTemplate reconciler exercises (CreateAtespace, CreateActor,
+// ResumeActor, SuspendActor, DeleteActor) record their calls and support
+// per-test response overrides; the unused methods panic so accidental new call
+// sites surface.
+type fakeControlClient struct {
+	mu    sync.Mutex
+	calls []fakeControlCall
+
+	deleteActorFn func(*ateapipb.DeleteActorRequest) (*ateapipb.Actor, error)
+}
+
+func (f *fakeControlClient) record(method, actorID string) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.calls = append(f.calls, fakeControlCall{method: method, actorID: actorID})
+}
+
+// Calls returns a snapshot of all recorded calls.
+func (f *fakeControlClient) Calls() []fakeControlCall {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	out := make([]fakeControlCall, len(f.calls))
+	copy(out, f.calls)
+	return out
+}
+
+// CallCount counts recorded calls for a method, scoped to one actor ID so
+// tests sharing the suite-level fake stay isolated.
+func (f *fakeControlClient) CallCount(method, actorID string) int {
+	n := 0
+	for _, c := range f.Calls() {
+		if c.method == method && c.actorID == actorID {
+			n++
+		}
+	}
+	return n
+}
+
+// SetDeleteActorFn installs a per-test DeleteActor override; reset it to nil in
+// t.Cleanup.
+func (f *fakeControlClient) SetDeleteActorFn(fn func(*ateapipb.DeleteActorRequest) (*ateapipb.Actor, error)) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.deleteActorFn = fn
+}
+
+func (f *fakeControlClient) getDeleteActorFn() func(*ateapipb.DeleteActorRequest) (*ateapipb.Actor, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.deleteActorFn
+}
+
+func (f *fakeControlClient) CreateAtespace(ctx context.Context, in *ateapipb.CreateAtespaceRequest, opts ...grpc.CallOption) (*ateapipb.Atespace, error) {
+	return &ateapipb.Atespace{}, nil
+}
+
+func (f *fakeControlClient) CreateActor(ctx context.Context, in *ateapipb.CreateActorRequest, opts ...grpc.CallOption) (*ateapipb.Actor, error) {
+	f.record("CreateActor", in.GetActor().GetMetadata().GetName())
+	return &ateapipb.Actor{}, nil
+}
+
+func (f *fakeControlClient) ResumeActor(ctx context.Context, in *ateapipb.ResumeActorRequest, opts ...grpc.CallOption) (*ateapipb.ResumeActorResponse, error) {
+	f.record("ResumeActor", in.GetActor().GetName())
+	return &ateapipb.ResumeActorResponse{}, nil
+}
+
+func (f *fakeControlClient) SuspendActor(ctx context.Context, in *ateapipb.SuspendActorRequest, opts ...grpc.CallOption) (*ateapipb.SuspendActorResponse, error) {
+	f.record("SuspendActor", in.GetActor().GetName())
+	// External snapshot present so the reconciler can advance to PhaseReady.
+	return &ateapipb.SuspendActorResponse{
+		Actor: &ateapipb.Actor{
+			LatestSnapshotInfo: &ateapipb.SnapshotInfo{
+				Data: &ateapipb.SnapshotInfo_External{
+					External: &ateapipb.ExternalSnapshotInfo{SnapshotUriPrefix: "gs://test-bucket/snap"},
+				},
+			},
+		},
+	}, nil
+}
+
+func (f *fakeControlClient) DeleteActor(ctx context.Context, in *ateapipb.DeleteActorRequest, opts ...grpc.CallOption) (*ateapipb.Actor, error) {
+	f.record("DeleteActor", in.GetActor().GetName())
+	if fn := f.getDeleteActorFn(); fn != nil {
+		return fn(in)
+	}
+	return &ateapipb.Actor{}, nil
+}
+
+// --- methods unused by the reconciler: panic to surface new call sites ---
+
+func (f *fakeControlClient) GetActor(context.Context, *ateapipb.GetActorRequest, ...grpc.CallOption) (*ateapipb.Actor, error) {
+	panic("GetActor: unused in controller tests")
+}
+
+func (f *fakeControlClient) UpdateActor(context.Context, *ateapipb.UpdateActorRequest, ...grpc.CallOption) (*ateapipb.UpdateActorResponse, error) {
+	panic("UpdateActor: unused in controller tests")
+}
+
+func (f *fakeControlClient) PauseActor(context.Context, *ateapipb.PauseActorRequest, ...grpc.CallOption) (*ateapipb.PauseActorResponse, error) {
+	panic("PauseActor: unused in controller tests")
+}
+
+func (f *fakeControlClient) ListWorkers(context.Context, *ateapipb.ListWorkersRequest, ...grpc.CallOption) (*ateapipb.ListWorkersResponse, error) {
+	panic("ListWorkers: unused in controller tests")
+}
+
+func (f *fakeControlClient) ListActors(context.Context, *ateapipb.ListActorsRequest, ...grpc.CallOption) (*ateapipb.ListActorsResponse, error) {
+	panic("ListActors: unused in controller tests")
+}
+
+func (f *fakeControlClient) GetAtespace(context.Context, *ateapipb.GetAtespaceRequest, ...grpc.CallOption) (*ateapipb.Atespace, error) {
+	panic("GetAtespace: unused in controller tests")
+}
+
+func (f *fakeControlClient) ListAtespaces(context.Context, *ateapipb.ListAtespacesRequest, ...grpc.CallOption) (*ateapipb.ListAtespacesResponse, error) {
+	panic("ListAtespaces: unused in controller tests")
+}
+
+func (f *fakeControlClient) DeleteAtespace(context.Context, *ateapipb.DeleteAtespaceRequest, ...grpc.CallOption) (*ateapipb.Atespace, error) {
+	panic("DeleteAtespace: unused in controller tests")
+}
