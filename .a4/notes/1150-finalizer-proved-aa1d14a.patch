+// reconcileDelete suspends + deletes the golden actor in ate-api, then
+// removes the finalizer so K8s can GC the CR.
+func (r *ActorTemplateReconciler) reconcileDelete(ctx context.Context, at *atev1alpha1.ActorTemplate) (ctrl.Result, error) {
+	logger := log.FromContext(ctx)
+
+	if !controllerutil.ContainsFinalizer(at, ActorTemplateFinalizer) {
+		// Already cleaned (or the template never reached the phase where the
+		// finalizer was added). Let K8s GC proceed.
+		return ctrl.Result{}, nil
+	}
+
+	actorID := at.Status.GoldenActorID
+	if actorID != "" {
+		ref := &ateapipb.ObjectRef{Atespace: resources.GoldenActorAtespace, Name: actorID}
+
+		// SuspendActor is idempotent (workflow-level IsComplete guards):
+		// already-suspended returns success with no side-effect, not an
+		// error. Only NotFound (actor gone) is treated as success here.
+		if _, err := r.AteClient.SuspendActor(ctx, &ateapipb.SuspendActorRequest{
+			Actor: ref,
+		}); err != nil {
+			if !isNotFound(err) {
+				logger.Error(err, "failed to suspend golden actor on deletion", "actorID", actorID)
+				return ctrl.Result{}, fmt.Errorf("suspend before delete: %w", err)
+			}
+			logger.Info("golden actor already absent on suspend", "actorID", actorID)
+		}
+
+		// DeleteActor's FailedPrecondition response ("actor is not
+		// suspended") is the safety net for the unlikely race where Suspend
+		// succeeded-no-op against a stale GoldenActorID. Propagate as an
+		// error so the controller requeues and re-runs with fresh status.
+		if _, err := r.AteClient.DeleteActor(ctx, &ateapipb.DeleteActorRequest{
+			Actor: ref,
+		}); err != nil {
+			if !isNotFound(err) {
+				logger.Error(err, "failed to delete golden actor", "actorID", actorID)
+				return ctrl.Result{}, fmt.Errorf("delete golden actor: %w", err)
+			}
+			logger.Info("golden actor already absent on delete", "actorID", actorID)
+		}
+	} else {
+		logger.Info("no golden actor ID recorded; removing finalizer without RPC calls")
+	}
+
+	controllerutil.RemoveFinalizer(at, ActorTemplateFinalizer)
+	if err := r.Update(ctx, at); err != nil {
+		return ctrl.Result{}, fmt.Errorf("failed to remove finalizer: %w", err)
+	}
+	return ctrl.Result{}, nil
+}
+
+func isNotFound(err error) bool {
+	s, ok := status.FromError(err)
+	return ok && s.Code() == codes.NotFound
+}
