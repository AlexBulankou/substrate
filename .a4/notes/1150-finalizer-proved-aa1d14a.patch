+// limitations under the License.
+
+package controllers
+
+import (
+	"context"
+	"sync"
+	"testing"
+
+	atev1alpha1 "github.com/agent-substrate/substrate/pkg/api/v1alpha1"
+	"github.com/agent-substrate/substrate/pkg/proto/ateapipb"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+	k8errors "k8s.io/apimachinery/pkg/api/errors"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/types"
+)
+
+func makeActorTemplate(name, namespace string) *atev1alpha1.ActorTemplate {
+	return &atev1alpha1.ActorTemplate{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:      name,
+			Namespace: namespace,
+		},
+		Spec: atev1alpha1.ActorTemplateSpec{
+			PauseImage: "gcr.io/gke-release/pause@sha256:bcbd57ba5653580ec647b16d8163cdd1112df3609129b01f912a8032e48265da",
+			Containers: []atev1alpha1.Container{
+				{
+					Name:  "main",
+					Image: "busybox@sha256:326e0e090a9a4057e62a1b94236e7a2df2f2f76722f67232e0e47854e4df9c53",
+				},
+			},
+			SnapshotsConfig: atev1alpha1.SnapshotsConfig{
+				Location: "gs://test-bucket/test-folder",
+			},
+		},
+	}
+}
+
+// startActorTemplate creates the ActorTemplate and waits until the reconciler
+// has created the golden actor (GoldenActorID set) and added the finalizer.
+// Returns the golden actor ID.
+func startActorTemplate(t *testing.T, at *atev1alpha1.ActorTemplate) string {
+	t.Helper()
+
+	if err := k8sClient.Create(testCtx, at); err != nil {
+		t.Fatalf("create ActorTemplate: %v", err)
+	}
+
+	key := types.NamespacedName{Name: at.Name, Namespace: at.Namespace}
+	var goldenID string
+	eventually(t, func(ctx context.Context) (bool, error) {
+		got := &atev1alpha1.ActorTemplate{}
+		if err := k8sClient.Get(ctx, key, got); err != nil {
+			return false, nil
+		}
+		if got.Status.GoldenActorID == "" {
+			return false, nil
+		}
+		// Pre-condition (STRUCTURAL-2): the finalizer must be on the object
+		// BEFORE we delete; otherwise the deletion specs pass by accident on
+		// an empty reconciler.
+		for _, f := range got.Finalizers {
+			if f == ActorTemplateFinalizer {
+				goldenID = got.Status.GoldenActorID
+				return true, nil
+			}
+		}
+		return false, nil
+	})
+
+	if n := fakeAte.CallCount("CreateActor", goldenID); n < 1 {
+		t.Fatalf("expected CreateActor(%s) to have fired, got %d calls", goldenID, n)
+	}
+	if n := fakeAte.CallCount("DeleteActor", goldenID); n != 0 {
+		t.Fatalf("DeleteActor(%s) must not fire before deletion, got %d calls", goldenID, n)
+	}
+	return goldenID
+}
+
+func waitReaped(t *testing.T, key types.NamespacedName) {
+	t.Helper()
+	eventually(t, func(ctx context.Context) (bool, error) {
+		err := k8sClient.Get(ctx, key, &atev1alpha1.ActorTemplate{})
+		return k8errors.IsNotFound(err), nil
+	})
+}
+
+// TestActorTemplateDeleteFiresDeleteActor is the leak reproducer: deleting an
+// ActorTemplate whose golden actor exists must suspend + delete that actor in
+// ate-api before the CR is reaped. Pre-finalizer this test fails — the
+// controller returned early on DeletionTimestamp without any RPC.
+func TestActorTemplateDeleteFiresDeleteActor(t *testing.T) {
+	at := makeActorTemplate("at-finalizer-success", "default")
+	goldenID := startActorTemplate(t, at)
+	key := types.NamespacedName{Name: at.Name, Namespace: at.Namespace}
+
+	if err := k8sClient.Delete(testCtx, at); err != nil {
+		t.Fatalf("delete ActorTemplate: %v", err)
+	}
+
+	// THE LEAK ASSERTION: DeleteActor(goldenID) must fire.
+	eventually(t, func(ctx context.Context) (bool, error) {
+		return fakeAte.CallCount("DeleteActor", goldenID) >= 1, nil
+	})
+	// Suspend-before-delete ordering is part of the contract.
+	if n := fakeAte.CallCount("SuspendActor", goldenID); n < 1 {
+		t.Fatalf("expected SuspendActor(%s) before DeleteActor, got %d calls", goldenID, n)
+	}
+
+	waitReaped(t, key)
+}
+
+// TestActorTemplateDeleteActorNotFound verifies NotFound from DeleteActor is
+// treated as terminal success (concurrent-delete race) — the CR must still be
+// reaped, with no infinite requeue.
+func TestActorTemplateDeleteActorNotFound(t *testing.T) {
+	at := makeActorTemplate("at-finalizer-notfound", "default")
+	goldenID := startActorTemplate(t, at)
+	key := types.NamespacedName{Name: at.Name, Namespace: at.Namespace}
+
+	fakeAte.SetDeleteActorFn(func(req *ateapipb.DeleteActorRequest) (*ateapipb.Actor, error) {
+		if req.GetActor().GetName() == goldenID {
+			return nil, status.Error(codes.NotFound, "actor gone")
+		}
+		return &ateapipb.Actor{}, nil
+	})
+	t.Cleanup(func() { fakeAte.SetDeleteActorFn(nil) })
+
+	if err := k8sClient.Delete(testCtx, at); err != nil {
+		t.Fatalf("delete ActorTemplate: %v", err)
+	}
+
+	// STRUCTURAL-2: the RPC must actually fire — NotFound is the response
+	// branch under test; "no call at all" would be a different bug.
+	eventually(t, func(ctx context.Context) (bool, error) {
+		return fakeAte.CallCount("DeleteActor", goldenID) >= 1, nil
+	})
+
+	waitReaped(t, key)
+}
+
+// TestActorTemplateDeleteActorFailedPrecondition verifies FailedPrecondition
+// from DeleteActor (stale GoldenActorID safety net) requeues: the finalizer
+// must re-Suspend and re-Delete on the next reconcile.
+func TestActorTemplateDeleteActorFailedPrecondition(t *testing.T) {
+	at := makeActorTemplate("at-finalizer-failedprecond", "default")
+	goldenID := startActorTemplate(t, at)
+	key := types.NamespacedName{Name: at.Name, Namespace: at.Namespace}
+
+	var mu sync.Mutex
+	attempts := 0
+	fakeAte.SetDeleteActorFn(func(req *ateapipb.DeleteActorRequest) (*ateapipb.Actor, error) {
+		if req.GetActor().GetName() != goldenID {
+			return &ateapipb.Actor{}, nil
+		}
+		mu.Lock()
+		defer mu.Unlock()
+		attempts++
+		if attempts == 1 {
+			return nil, status.Error(codes.FailedPrecondition, "actor not suspended")
+		}
+		return &ateapipb.Actor{}, nil
+	})
+	t.Cleanup(func() { fakeAte.SetDeleteActorFn(nil) })
+
+	if err := k8sClient.Delete(testCtx, at); err != nil {
+		t.Fatalf("delete ActorTemplate: %v", err)
+	}
+
+	// STRUCTURAL-2: >=2 DeleteActor calls — initial-fail -> requeue -> success.
+	eventually(t, func(ctx context.Context) (bool, error) {
+		return fakeAte.CallCount("DeleteActor", goldenID) >= 2, nil
+	})
+
+	// STRUCTURAL-3: SuspendActor >=2 characterizes the FULL safety-net path:
+	// Suspend -> Delete-fail -> requeue -> Suspend-again -> Delete-again. A
+	// one-Suspend assertion would pass even if the requeue forgot to
+	// re-Suspend before re-Deleting.
+	if n := fakeAte.CallCount("SuspendActor", goldenID); n < 2 {
+		t.Fatalf("FailedPrecondition requeue must re-Suspend before re-Delete: expected SuspendActor(%s) >= 2, got %d", goldenID, n)
+	}
+
+	waitReaped(t, key)
+}
