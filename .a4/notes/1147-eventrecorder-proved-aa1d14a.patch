+// fakeAteClient is a narrow ateapipb.ControlClient stub: it embeds the
+// interface (so unimplemented methods panic if hit, surfacing accidental use)
+// and overrides only the RPCs the ActorTemplate reconciler drives.
+type fakeAteClient struct {
+	ateapipb.ControlClient
+
+	createErr  error
+	resumeErr  error
+	suspendErr error
+	snapshot   string
+}
+
+func (f *fakeAteClient) CreateAtespace(ctx context.Context, in *ateapipb.CreateAtespaceRequest, opts ...grpc.CallOption) (*ateapipb.Atespace, error) {
+	return &ateapipb.Atespace{}, nil
+}
+
+func (f *fakeAteClient) CreateActor(ctx context.Context, in *ateapipb.CreateActorRequest, opts ...grpc.CallOption) (*ateapipb.Actor, error) {
+	if f.createErr != nil {
+		return nil, f.createErr
+	}
+	return &ateapipb.Actor{}, nil
+}
+
+func (f *fakeAteClient) ResumeActor(ctx context.Context, in *ateapipb.ResumeActorRequest, opts ...grpc.CallOption) (*ateapipb.ResumeActorResponse, error) {
+	if f.resumeErr != nil {
+		return nil, f.resumeErr
+	}
+	return &ateapipb.ResumeActorResponse{}, nil
+}
+
+func (f *fakeAteClient) SuspendActor(ctx context.Context, in *ateapipb.SuspendActorRequest, opts ...grpc.CallOption) (*ateapipb.SuspendActorResponse, error) {
+	if f.suspendErr != nil {
+		return nil, f.suspendErr
+	}
+	return &ateapipb.SuspendActorResponse{
+		Actor: &ateapipb.Actor{
+			LatestSnapshotInfo: &ateapipb.SnapshotInfo{
+				Data: &ateapipb.SnapshotInfo_External{
+					External: &ateapipb.ExternalSnapshotInfo{SnapshotUriPrefix: f.snapshot},
+				},
+			},
+		},
+	}, nil
+}
+
+func atScheme(t *testing.T) *runtime.Scheme {
+	t.Helper()
+	s := runtime.NewScheme()
+	if err := clientgoscheme.AddToScheme(s); err != nil {
+		t.Fatalf("add clientgo scheme: %v", err)
+	}
+	if err := atev1alpha1.AddToScheme(s); err != nil {
+		t.Fatalf("add ate scheme: %v", err)
+	}
+	return s
+}
+
+func newActorTemplate(name string) *atev1alpha1.ActorTemplate {
+	return &atev1alpha1.ActorTemplate{
+		ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: "default"},
+	}
+}
+
+// drainEvents collects all currently-buffered events from a FakeRecorder
+// without blocking once the channel is empty.
+func drainEvents(rec *record.FakeRecorder) []string {
+	var got []string
+	for {
+		select {
+		case e := <-rec.Events:
+			got = append(got, e)
+		default:
+			return got
+		}
+	}
+}
+
+func containsEvent(events []string, substr string) bool {
+	for _, e := range events {
+		if strings.Contains(e, substr) {
+			return true
+		}
+	}
+	return false
+}
+
+// TestActorTemplateEmitsPhaseEvents drives the ActorTemplate reconciler through
+// its full happy-path phase machine (Initial -> ResumeGoldenActor ->
+// WaitGoldenActor -> Ready) and asserts a Normal Event is recorded at each
+// transition. This proves the #1147 EventRecorder wiring: each Status().Update
+// is now paired with an object Event, so `kubectl describe actortemplate/...`
+// surfaces the lifecycle that previously lived only in controller logs.
+func TestActorTemplateEmitsPhaseEvents(t *testing.T) {
+	at := newActorTemplate("test-events")
+	scheme := atScheme(t)
+	c := fake.NewClientBuilder().
+		WithScheme(scheme).
+		WithObjects(at).
+		WithStatusSubresource(&atev1alpha1.ActorTemplate{}).
+		Build()
+	rec := record.NewFakeRecorder(16)
+	r := &ActorTemplateReconciler{
+		Client:    c,
+		Scheme:    scheme,
+		Recorder:  rec,
+		AteClient: &fakeAteClient{snapshot: "snap-golden"},
+	}
+	ctx := context.Background()
+	req := ctrl.Request{NamespacedName: types.NamespacedName{Name: at.Name, Namespace: at.Namespace}}
+
+	// Phase Initial -> ResumeGoldenActor: expect GoldenActorCreated.
+	if _, err := r.Reconcile(ctx, req); err != nil {
+		t.Fatalf("reconcile (initial): %v", err)
+	}
+	if ev := drainEvents(rec); !containsEvent(ev, "GoldenActorCreated") || !containsEvent(ev, "Normal") {
+		t.Fatalf("expected Normal GoldenActorCreated event, got %v", ev)
+	}
+	assertPhase(t, ctx, c, at, atev1alpha1.PhaseResumeGoldenActor)
+
+	// Phase ResumeGoldenActor -> WaitGoldenActor: expect GoldenActorResumed.
+	if _, err := r.Reconcile(ctx, req); err != nil {
+		t.Fatalf("reconcile (resume): %v", err)
+	}
+	if ev := drainEvents(rec); !containsEvent(ev, "GoldenActorResumed") {
+		t.Fatalf("expected GoldenActorResumed event, got %v", ev)
+	}
+	assertPhase(t, ctx, c, at, atev1alpha1.PhaseWaitGoldenActor)
+
+	// The wait phase requeues until TakeGoldenSnapshotAt elapses; fast-forward
+	// by stamping it into the past, then reconcile.
+	cur := &atev1alpha1.ActorTemplate{}
+	if err := c.Get(ctx, req.NamespacedName, cur); err != nil {
+		t.Fatalf("get for fast-forward: %v", err)
+	}
+	cur.Status.TakeGoldenSnapshotAt = metav1.NewTime(time.Now().Add(-time.Second))
+	if err := c.Status().Update(ctx, cur); err != nil {
+		t.Fatalf("fast-forward status update: %v", err)
+	}
+
+	// Phase WaitGoldenActor -> Ready: expect Ready event + persisted snapshot.
+	if _, err := r.Reconcile(ctx, req); err != nil {
+		t.Fatalf("reconcile (wait->ready): %v", err)
+	}
+	if ev := drainEvents(rec); !containsEvent(ev, "Ready") {
+		t.Fatalf("expected Ready event, got %v", ev)
+	}
+	final := &atev1alpha1.ActorTemplate{}
+	if err := c.Get(ctx, req.NamespacedName, final); err != nil {
+		t.Fatalf("get final: %v", err)
+	}
+	if final.Status.Phase != atev1alpha1.PhaseReady {
+		t.Fatalf("expected phase Ready, got %q", final.Status.Phase)
+	}
+	if final.Status.GoldenSnapshot != "snap-golden" {
+		t.Fatalf("expected golden snapshot persisted, got %q", final.Status.GoldenSnapshot)
+	}
+
+	// Phase Ready is terminal and emits no further events.
+	if _, err := r.Reconcile(ctx, req); err != nil {
+		t.Fatalf("reconcile (ready): %v", err)
+	}
+	if ev := drainEvents(rec); len(ev) != 0 {
+		t.Fatalf("expected no events in terminal Ready phase, got %v", ev)
+	}
+}
+
+// TestActorTemplateEmitsWarningOnCreateFailure proves the Warning path: when the
+// upstream CreateActor RPC fails, the reconciler records a Warning Event so the
+// failure is visible on the object, not just in the controller log.
+func TestActorTemplateEmitsWarningOnCreateFailure(t *testing.T) {
+	at := newActorTemplate("test-create-fail")
+	scheme := atScheme(t)
+	c := fake.NewClientBuilder().
+		WithScheme(scheme).
+		WithObjects(at).
+		WithStatusSubresource(&atev1alpha1.ActorTemplate{}).
+		Build()
+	rec := record.NewFakeRecorder(16)
+	r := &ActorTemplateReconciler{
+		Client:    c,
+		Scheme:    scheme,
+		Recorder:  rec,
+		AteClient: &fakeAteClient{createErr: errors.New("ate unavailable")},
+	}
+	ctx := context.Background()
+	req := ctrl.Request{NamespacedName: types.NamespacedName{Name: at.Name, Namespace: at.Namespace}}
+
+	if _, err := r.Reconcile(ctx, req); err == nil {
+		t.Fatal("expected reconcile error on CreateActor failure, got nil")
+	}
+	ev := drainEvents(rec)
+	if !containsEvent(ev, "Warning") || !containsEvent(ev, "CreateGoldenActorFailed") {
+		t.Fatalf("expected Warning CreateGoldenActorFailed event, got %v", ev)
+	}
+}
+
+// TestActorTemplateNilRecorderNoPanic proves the eventf nil-guard: a reconciler
+// constructed without a Recorder must not panic when it reaches an emit site.
+func TestActorTemplateNilRecorderNoPanic(t *testing.T) {
+	at := newActorTemplate("test-nil-rec")
+	scheme := atScheme(t)
+	c := fake.NewClientBuilder().
+		WithScheme(scheme).
+		WithObjects(at).
+		WithStatusSubresource(&atev1alpha1.ActorTemplate{}).
+		Build()
+	r := &ActorTemplateReconciler{
+		Client:    c,
+		Scheme:    scheme,
+		AteClient: &fakeAteClient{snapshot: "snap"},
+	}
+	ctx := context.Background()
+	req := ctrl.Request{NamespacedName: types.NamespacedName{Name: at.Name, Namespace: at.Namespace}}
+	if _, err := r.Reconcile(ctx, req); err != nil {
+		t.Fatalf("reconcile with nil Recorder: %v", err)
+	}
+}
+
+func assertPhase(t *testing.T, ctx context.Context, c client.Client, at *atev1alpha1.ActorTemplate, want atev1alpha1.PhaseType) {
+	t.Helper()
+	cur := &atev1alpha1.ActorTemplate{}
+	if err := c.Get(ctx, types.NamespacedName{Name: at.Name, Namespace: at.Namespace}, cur); err != nil {
+		t.Fatalf("get for phase assert: %v", err)
+	}
+	if cur.Status.Phase != want {
+		t.Fatalf("expected phase %q, got %q", want, cur.Status.Phase)
+	}
+}
