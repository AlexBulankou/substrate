+// TestWorkerPoolEmitsDeploymentAppliedEvent proves the #1147 EventRecorder
+// wiring end-to-end through the production path: the manager-built reconciler in
+// TestMain sets its Recorder via SetupWithManager's GetEventRecorderFor, so a
+// successful applyDeployment broadcasts a real corev1.Event to the apiserver.
+// This complements the ActorTemplate FakeRecorder unit tests by proving the
+// actual mgr.GetEventRecorderFor path, not just a stubbed recorder.
+func TestWorkerPoolEmitsDeploymentAppliedEvent(t *testing.T) {
+	wp := makeWorkerPool("test-event", "default", 1, "ateom:v1")
+	if err := k8sClient.Create(testCtx, wp); err != nil {
+		t.Fatalf("create WorkerPool: %v", err)
+	}
+	t.Cleanup(func() { k8sClient.Delete(testCtx, wp) }) //nolint:errcheck
+
+	eventually(t, func(ctx context.Context) (bool, error) {
+		events := &corev1.EventList{}
+		if err := k8sClient.List(ctx, events, client.InNamespace(wp.Namespace)); err != nil {
+			return false, nil
+		}
+		for _, e := range events.Items {
+			if e.InvolvedObject.Kind == "WorkerPool" &&
+				e.InvolvedObject.Name == wp.Name &&
+				e.Reason == "DeploymentApplied" &&
+				e.Type == corev1.EventTypeNormal {
+				return true, nil
+			}
+		}
+		return false, nil
+	})
+}
