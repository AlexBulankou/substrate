+// TestStatusObservedGeneration verifies the controller stamps
+// status.observedGeneration with the WorkerPool's metadata.generation when it
+// writes status, so consumers can tell whether a status reflects the current spec.
+func TestStatusObservedGeneration(t *testing.T) {
+	wp := makeWorkerPool("test-observedgen", "default", 2, "ateom:v1")
+	if err := k8sClient.Create(testCtx, wp); err != nil {
+		t.Fatalf("create WorkerPool: %v", err)
+	}
+	t.Cleanup(func() { k8sClient.Delete(testCtx, wp) }) //nolint:errcheck
+
+	eventually(t, func(ctx context.Context) (bool, error) {
+		_, err := getDeployment(ctx, wp)
+		return err == nil, nil
+	})
+
+	// Drive a status write by simulating the deployment controller reporting pods.
+	updateDeploymentStatus(t, wp, "patch Deployment status", func(dep *appsv1.Deployment) {
+		dep.Status.Replicas = 2
+	})
+
+	eventually(t, func(ctx context.Context) (bool, error) {
+		current := &atev1alpha1.WorkerPool{}
+		if err := k8sClient.Get(ctx, types.NamespacedName{Name: wp.Name, Namespace: wp.Namespace}, current); err != nil {
+			return false, nil
+		}
+		return current.Status.ObservedGeneration == current.Generation && current.Generation > 0, nil
+	})
+}
